{
  "name": "uniprix-investment",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "sass SCSS/style.scss dist/style.css --style=compressed --no-source-map",
    "build:site": "npm run build:css && eleventy",
    "dev": "npm run build:css && eleventy --serve",
    "watch:css": "sass SCSS/style.scss dist/style.css --watch --style=compressed --no-source-map"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "sass": "^1.89.0"
  }
}
